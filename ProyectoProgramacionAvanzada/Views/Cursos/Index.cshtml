@model IEnumerable<ProyectoProgramacionAvanzada.Cursos>
@{
    ViewBag.Title = "Cursos";
}

<h2>Cursos</h2>

<p>
    <a href="@Url.Action("Create","Cursos")" class="btn btn-success btn-lg rounded shadow">Agregar nuevo curso</a>
</p>

<table class="table table-striped shadow rounded">
    <thead class="table-dark">
        <tr>
            <th>@Html.DisplayNameFor(model => model.NombreCurso)</th>
            <th>@Html.DisplayNameFor(model => model.Descripcion)</th>
            <th>Acciones</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@Html.DisplayFor(modelItem => item.NombreCurso)</td>
                <td>@Html.DisplayFor(modelItem => item.Descripcion)</td>
                <td>
                    @Html.ActionLink("Editar", "Edit", new { id = item.IdCurso }, new { @class = "btn btn-warning btn-sm rounded" }) |
                    @Html.ActionLink("Detalles", "Details", new { id = item.IdCurso }, new { @class = "btn btn-primary btn-sm rounded" }) |
                    @Html.ActionLink("Eliminar", "Delete", new { id = item.IdCurso }, new { @class = "btn btn-danger btn-sm rounded" })
                </td>
            </tr>
        }
    </tbody>
</table>