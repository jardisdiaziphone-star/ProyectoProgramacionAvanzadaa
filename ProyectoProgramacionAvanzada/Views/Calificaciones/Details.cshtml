@model ProyectoProgramacionAvanzada.Calificaciones

<h2>Detalles de Calificación</h2>

<dl class="dl-horizontal">
    <dt>Estudiante</dt>
    <dd>@Model.Estudiantes.Nombre</dd>

    <dt>Criterio</dt>
    <dd>@Model.Criterios.Nombre</dd>

    <dt>Nota Base</dt>
    <dd>@Model.NotaBase</dd>

    <dt>Nota Final (escala 0–100)</dt>
    <dd>@string.Format("{0:0.00}", Model.NotaFinal)</dd>
</dl>

<p>@Html.ActionLink("Volver al listado", "Index")</p>