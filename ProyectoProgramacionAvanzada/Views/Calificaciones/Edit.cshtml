@model ProyectoProgramacionAvanzada.Calificaciones

<h2>Editar Calificación</h2>

@using (Html.BeginForm()) {
    @Html.AntiForgeryToken()

    <!-- Campo oculto para enviar la clave primaria -->
    @Html.HiddenFor(m => m.IdCalificacion)

    <div class="form-group">
        @Html.LabelFor(m => m.IdEstudiante, "Estudiante")
        @Html.DropDownList("IdEstudiante", null, new { @class = "form-control" })
    </div>

    <div class="form-group">
        @Html.LabelFor(m => m.IdCriterio, "Criterio")
        @Html.DropDownList("IdCriterio", null, new { @class = "form-control" })
    </div>

    <div class="form-group">
        @Html.LabelFor(m => m.NotaBase, "Nota obtenida")
        @Html.EditorFor(m => m.NotaBase, new { htmlAttributes = new { @class = "form-control" } })
    </div>

    <!-- Mostrar la nota final calculada solo como información -->
    <div class="form-group">
        <label>Nota final (aporte)</label>
        <input type="text" class="form-control" 
               value="@string.Format("{0:0.00}", Model.NotaFinal)" readonly />
    </div>

    <input type="submit" value="Guardar cambios" class="btn btn-success" />
}

<p>@Html.ActionLink("Volver al listado", "Index")</p>
