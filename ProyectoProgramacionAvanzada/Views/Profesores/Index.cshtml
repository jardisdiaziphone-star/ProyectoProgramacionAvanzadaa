@model IEnumerable<ProyectoProgramacionAvanzada.Profesores>
@{
    ViewBag.Title = "Profesores";
}

<h2>Profesores</h2>

<p>
    <a href="@Url.Action("Create","Profesores")" class="btn btn-success btn-lg rounded shadow">Agregar nuevo profesor</a>
</p>

<table class="table table-striped shadow rounded">
    <thead class="table-dark">
        <tr>
            <th>@Html.DisplayNameFor(model => model.Nombre)</th>
            <th>@Html.DisplayNameFor(model => model.Especialidad)</th>
            <th>Acciones</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@Html.DisplayFor(modelItem => item.Nombre)</td>
                <td>@Html.DisplayFor(modelItem => item.Especialidad)</td>
                <td>
                    @Html.ActionLink("Editar", "Edit", new { id = item.IdProfesor }, new { @class = "btn btn-warning btn-sm rounded" }) |
                    @Html.ActionLink("Detalles", "Details", new { id = item.IdProfesor }, new { @class = "btn btn-primary btn-sm rounded" }) |
                    @Html.ActionLink("Eliminar", "Delete", new { id = item.IdProfesor }, new { @class = "btn btn-danger btn-sm rounded" })
                </td>
            </tr>
        }
    </tbody>
</table>